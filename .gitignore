# Archon Genesis local state
.archon/

# Local agent guidance generated from the Genesis seed
AGENTS.md
CLAUDE.md
GEMINI.md

# Local-only audit findings and generated reports (never publish to the public
# repo). Directory-scoped so new files land ignored by default rather than
# needing a rule per filename. The root-level AUDIT*.md pattern is kept as a
# backstop: tooling has historically written reports to the repo root, and an
# un-ignored one there is exactly the file that must never be published.
/audit/
/reports/
/AUDIT*.md

# Local/private configuration
.env
.env.*

# Added by cargo
/target

# macOS release build output
/dist/build

# Locally-built release tarball (the published artifact of the same name is
# produced by CI; a local copy must never be committed into the repo).
/odytty.tar.gz

# Locally-built Windows release artifacts and installer work dirs
*.exe
*.zip
*.pdb
*.msi
/wix/
target/wix/

# Raw LLVM coverage profiles. The coverage runner writes its own profiles into
# an ignored output directory, but a test-spawned child that inherits a
# sanitized environment falls back to the default name in its working
# directory. Ignoring the pattern keeps an interrupted run from dirtying the
# tree.
*.profraw

# Default output from direct cargo-mutants invocations.
/mutants.out/

# Byte-code caches from the repository's Python helper scripts.
__pycache__/
