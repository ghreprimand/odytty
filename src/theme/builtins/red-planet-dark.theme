# OdyTTY theme - Red Planet Dark
# OdyTTY variant of the published Red Planet palette. Only the terminal canvas
# is darkened; the foreground, cursor, selection, and ANSI colors stay intact.
name = red-planet-dark
appearance = dark

foreground = #c2b790
background = #161616
clear = #161616

cursor = #c2b790
selection = #1b324a
search = #e8bf6a
border = #3a3833
inactive = #676767

color0 = #202020
color1 = #8c3432
color2 = #728271
color3 = #e8bf6a
color4 = #69819e
color5 = #896492
color6 = #5b8390
color7 = #b9aa99
color8 = #676767
color9 = #b55242
color10 = #869985
color11 = #ebeb91
color12 = #60827e
color13 = #de4974
color14 = #38add8
color15 = #d6bfb8
