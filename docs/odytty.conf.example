# Example OdyTTY config.
#
# Save as $XDG_CONFIG_HOME/odytty/odytty.conf or
# ~/.config/odytty/odytty.conf.
#
# Most values reload live while the native window is running. Environment
# variables set at startup override these keys for the whole session.

# Theme and OS appearance.
theme = odyssey-default
# theme = odyssey          # the classic pre-v0.6.0 palette
# theme = odyssey-jungle   # alias for odyssey-default
# theme = system
follow_os_theme = off
# os_theme_dark = odyssey
# os_theme_light = odyssey-light
themed_ui_roles = on

# Font and text.
font_family = Victor Mono
# font =
# font_weight =
font_size = 21
line_height = 1.0
text_gamma = 1.2
stem_darken = 0.7
subpixel = off
synthetic_styles = on
symbol_fallback = on
# symbol_font = auto
# symbol_map = U+E000-U+F8FF=Symbols Nerd Font

# Readability and rendering.
render_quality = high
min_contrast = 17.0
focus_dim = 0.0
# Dim the non-focused panes of a multi-pane tab (0.0 = off, byte-identical).
inactive_pane_dim = 0.0
geometric_boxdraw = on
box_thickness = 1.0
window_padding = 4
window_border = off
window_decorations = on
# Whole-window transparency: draw the terminal background translucent so the
# desktop shows through (text/cursor/selection/overlays stay opaque). Off by
# default. Needs a compositing WM (Wayland native; X11 needs a compositor;
# Windows uses DWM). window_opacity is a 20..=100 percent (100 = fully opaque).
window_transparency = off
window_opacity = 85

# Show the tab bar even with a single tab. Off by default (a lone unnamed tab
# hides the bar). A single tab you have renamed always shows the bar regardless.
always_show_tab_bar = off

# Tabs always render on the top bar. `tab_bar_placement` now selects which side
# the WORKSPACE rail sits on when it is shown: top (rail defaults to the left),
# left, or right. Existing left/right vertical-tab configs are honored as the
# workspace-rail side.
tab_bar_placement = top

# Workspace rail (the sidebar listing workspaces): auto (default, appears once a
# second workspace exists — a single-workspace session shows no rail), always
# (pinned even with one workspace), or left/right (pinned to that side). auto and
# always inherit the side from tab_bar_placement. Hot-reloadable.
workspace_rail = auto

# Vertical-rail geometry (only affects left/right placements). Width in cells
# (8-32), inter-slot gap in rows (0-3), and slot height (1 = compact list that
# truncates long titles, 2 = padded rows that can wrap). All hot-reloadable.
tab_rail_width = 16
tab_rail_gap = 1
tab_rail_slot_rows = 2

# Tab panel: a quiet translucent surface behind the tab bar/rail so labels read
# against it. Strength 0 turns the panel off (bare labels over the wallpaper);
# higher values mute the wallpaper more. The seam is the thin hairline between
# the panel and the terminal content.
tab_panel_strength = 0.5
tab_seam = on

# Rail auto-hide: hide the vertical rail until the pointer reaches its window
# edge, then reveal it as a floating overlay (content never reflows on reveal).
# A tab-switch / new-tab / close chord flashes it briefly. `tab_rail_reveal_px`
# is the width (logical px, scaled for HiDPI) of the window-edge zone that
# triggers the reveal. Off by default.
tab_rail_autohide = off
tab_rail_reveal_px = 16

# Background treatments. OdyTTY ships with the bundled "Dark Waves" background
# on by default. To turn it OFF, use `background_treatment = color` (theme
# background only) or `background_image = none`.
background_treatment = image
# background_treatment = color     # disable the image; theme background only
# background_treatment = gradient
# background_treatment = vignette
# background_image selects the wallpaper. `default` = the bundled image;
# `none` = no image; or an absolute PNG/JPEG/WebP path for your own.
background_image = default
# background_image = /path/to/background.png
cell_bg_opacity = 0.8
background_blur_radius = 0
background_image_scrim = 0.5
# background_image_scrim = auto    # floor-safe auto-computed scrim

# Post-process effects. "ambient" is a compatibility alias for the CRT path
# when no explicit "crt" setting is present. "crt" always wins.
visual = ambient
bloom = on
bloom_threshold = 0.7
bloom_intensity = 0.7
bloom_radius = 8.0
retro = off
crt = on
crt_scanline_intensity = 0.17
crt_scanline_period = 7.0
crt_vignette_strength = 0.45
crt_curvature = 0.0

# Cursor and motion.
cursor_style = bar
cursor_blink = on
cursor_easing = on
cursor_motion = off
cursor_glow = off
cursor_trail = on
new_output_fade = off

# Input, selection, and tabs. Tab rename is available from the tab context menu.
scroll_wheel_lines = 6
# Lines of scrollback history retained before the oldest are dropped (0 =
# unlimited; bounds memory so endless output cannot exhaust RAM).
scrollback_lines = 10000
scroll_drag_speed = ramp
# Continuous pixel-precise scrolling for high-resolution wheels/touchpads
# (on by default); scroll_pixel_speed is the 1:1 sensitivity multiplier.
pixel_scroll = on
scroll_pixel_speed = 1.0
# Animate scrollback between discrete wheel notches (forward-chase glide).
# On by default; touchpads/hi-res wheels use pixel_scroll above instead.
scroll_glide = on
selection_drag_extend = on
scrollbar_drag = on
wheel_zoom = on
copy_on_select = off
# What plain Ctrl+C does. off (default) always sends the interrupt (^C).
# copy-or-interrupt: copy + clear the selection when text is selected, else
# interrupt. To interrupt while text is selected, press Esc first or Ctrl+C
# twice; Ctrl+Shift+C always copies. (Plain Ctrl+V stays verbatim-insert; bind
# `keybinds = ctrl+v=paste` if you want plain Ctrl+V to paste.)
smart_ctrl_c = copy-or-interrupt
# smart_ctrl_c = off   # plain Ctrl+C always interrupts (pre-v0.6.0 behavior)
confirm_close = on
# Terminal bell (BEL) handling. There is no audible bell; off/visual/urgent/all
# are the accepted values (urgent raises the window's urgency hint).
bell = urgent
command_status_gutter = off
sh_click = on
shell_integration = off
keybinds =
# Example:
# keybinds = ctrl+shift+y=copy;ctrl+alt+v=paste
# Default discoverability chords: the command palette, connection manager,
# session replay, and theme builder ship with default Ctrl+Shift chords —
# Ctrl+Shift+P (command-palette), Ctrl+Shift+S (connection-manager),
# Ctrl+Shift+R (session-replay), Ctrl+Shift+B (theme-builder). These are all
# Ctrl+Shift+<letter>, which a TUI cannot receive as input, so the PTY input
# path is unchanged. Prompt navigation uses the Ctrl+Shift+Up / Ctrl+Shift+Down
# arrow chords (there are no letter fallbacks). Add your own override to rebind
# any of these, e.g.
# keybinds = ctrl+alt+p=command-palette;ctrl+shift+p=jump-prompt-prev
# See docs/keybindings.md for the full default chord reference.

# Connection hosts for the SSH manager live in:
#   $XDG_CONFIG_HOME/odytty/hosts.conf
#   ~/.config/odytty/hosts.conf when XDG_CONFIG_HOME is unset
# Format:
#   Host web1
#       HostName web1.example.invalid
#       User deploy
#       Port 2222
#       Theme odyssey
#       Font "Victor Mono"
#       Title "Synthetic Web"
#
# The connect action opens system ssh in a new tab/session as:
#   ssh [-p PORT] -- [USER@]HOST
# OdyTTY never reads, stores, prompts for, or passes credentials, private keys,
# or passphrases; authentication remains with the system ssh binary and agent.
#
# OpenSSH config import is default-off. While off, OdyTTY does not read
# ~/.ssh/config. When on, the import is read-only, name-only, bounded, and never
# surfaces key directives or credentials.
#
# Browse and quick-connect to saved hosts through the connection-manager overlay.
# It opens with Ctrl+Shift+S by default (or the right-click menu's "Connection
# Manager" item); rebind via the connection-manager action, e.g.
# keybinds = ctrl+alt+h=connection-manager. The overlay is type-to-filter; Enter
# quick-connects, Esc dismisses. With ssh_config_hosts off it lists OdyTTY-owned
# hosts only and never references ~/.ssh.
ssh_config_hosts = off

# Remote shell integration for SSH tabs. Default on. When on, a connection
# injects OdyTTY's bash OSC 133 integration on the remote so a remote bash
# session gains the same prompt marks, cwd titles, and input boundaries as a
# local one. Nothing is persisted on the remote (the injected rcfile
# self-deletes on first read), and any failure or a non-bash remote shell
# degrades silently to a plain ssh session. Off globally makes every SSH tab's
# launch byte-identical to a plain ssh; a per-host "Integration off" line in
# hosts.conf opts a single host out. A remote tab titles itself user@host when
# no per-host Title is set. Authentication always stays with the system ssh.
remote_integration = on

# ControlMaster connection reuse for integrated SSH tabs. Default on. An
# integrated SSH tab adds OpenSSH ControlMaster/ControlPersist with a control
# socket OdyTTY owns under its state dir, so a second tab to the same host
# multiplexes over the first with no new handshake. If the shared master is gone
# the tab falls back to a normal fresh connect. A per-host "Reuse off" line in
# hosts.conf opts a single host out; off globally disables it. Reuse layers onto
# integrated sessions only. No effect on a Windows client (OpenSSH there has no
# connection multiplexing).
remote_reuse = on

# tmux persistence for integrated SSH tabs. Default OFF (opt-in). When on, an
# integrated SSH tab wraps the remote shell in "tmux new-session -A -s odytty",
# so a dropped-and-reconnected link reattaches the same remote session with its
# running programs and scrollback intact. Degrades to plain integrated bash when
# the remote has no tmux, so enabling it never breaks a session. A per-host
# "Tmux on"/"Tmux off" line in hosts.conf overrides for a single host. Only takes
# effect with remote_integration on (the bootstrap is the injection point).
remote_tmux = off

# Image paste-through for remote integrated SSH tabs. Default "ask". When a
# clipboard image is pasted into a remote integrated tab, a confirm prompt (with
# the encoded size + target host) offers to upload it: on Enter the PNG streams
# over the tab's ssh connection into a 0600 file under an unguessable
# /tmp/odytty-paste-<random>.png name, and the remote path is pasted into the
# shell as text (nothing is run remotely). "off" disables it; there is no silent
# auto-upload mode. Over-10MiB images are refused. Uploaded files are cleaned up
# best-effort on tab close. Only engages on a remote integrated tab.
remote_image_paste = ask

# Per-session output recording for the scrubbable replay overlay. Default off:
# while off the PTY pump records nothing and the path is byte-identical. When on,
# each session keeps a bounded in-memory ring of recent screen frames (capped by
# 600 frames AND 24 MiB, whichever binds first). Recording is local-only — frames
# never touch disk or the network and are dropped when the session closes. The
# scrubbable overlay opens with Ctrl+Shift+R by default (or the right-click
# menu's "Session Replay" item); rebind via the session-replay action, e.g.
# keybinds = ctrl+alt+r=session-replay.
session_replay = off

# Restore the previous workspace/tab/pane layout when odytty is launched with
# no arguments. Default off. Shape only — workspace names, tab titles and order,
# and each pane's split tree at its captured directory, each reopened with a
# fresh shell; terminal output, scrollback, and commands are never restored.
# Only a bare `odytty` restores; any argument (a flag, a path, -e, an attach id)
# starts fresh. The shape autosave (state-dir workspaces.json) runs regardless,
# so a snapshot is ready the moment this is turned on; with several windows open
# only the first (primary) one autosaves and restores.
restore_workspaces = off

# Multiplexer prefix for pane/split management (tmux-style). The prefix is
# captured only when the active tab has more than one pane; single-pane tabs pass
# Ctrl+b through to the shell unchanged. In a multi-pane tab, press the prefix,
# then a pane key: % / " split, arrows / o focus, x close, z zoom, space / =
# equalize. Press the prefix twice to send a literal prefix to the focused pane
# (so a tmux running inside OdyTTY still works). Set to off to disable and free
# the chord in multi-pane tabs too. Individual pane actions are rebindable via
# keybinds (the chord is the second key, after the prefix), e.g.
# keybinds = ctrl+f=zoom-pane.
pane_prefix = ctrl+b
# Example:
# pane_prefix = ctrl+a
# pane_prefix = off

# Detached-session CLI commands (`odytty new --detached`, `odytty list`,
# `odytty attach [--diagnostic] ID`) do not have config-file keys yet. By
# default, `attach <id>` reattaches a detached session in a live native window.
# `attach --diagnostic <id>` is the headless script/CI variant: it prints a
# one-line status dump and exits without opening a window. The host keeps the PTY
# and bounded terminal model alive until the child exits or the detached idle
# timeout reaps it.

# The command palette opens with Ctrl+Shift+P by default (or the right-click
# menu's "Command Palette" item) and is rebindable through keybinds above. When
# opened it reads conventional shell history files read-only with fixed caps: 1 MiB tail,
# 20,000 physical lines, 5,000 entries, 4,096 chars per entry. Accepting a
# history/directory row types it into the active pane without pressing Enter.

# Interactive (clickable) paths. The master gate is off by default; while off,
# path detection does nothing and the input/render paths are unchanged. When on,
# Ctrl+click opens a detected file or directory through the system opener
# (xdg-open on Linux, open on macOS). The sub-keys are inert until the gate is
# on:
#   interactive_paths_barewords    detect unadorned paths, not just OSC 8 links
#   interactive_paths_click_hint   show the "Ctrl+click to open" teaching chip
#   interactive_paths_image_inline open image paths (png/jpg/jpeg/webp) in the
#                                  in-app lightbox (dismiss with Esc or by
#                                  clicking outside)
#   interactive_paths_editor       editor command template for :line:col jumps
#                                  (empty = fall back to the system opener)
# Clickable bare URLs (on by default): a printed http(s):// URL gets a hand
# cursor + Ctrl+hover underline and opens in the browser on Ctrl+click. Only
# http/https/file/mailto open; never auto-opened, never shell-interpolated.
# Independent of interactive_paths below. Set off to disable (byte-identical).
interactive_urls = on
interactive_paths = off
interactive_paths_barewords = on
interactive_paths_click_hint = on
interactive_paths_image_inline = on
interactive_paths_editor =

# Clipboard and accessibility. See docs/accessibility.md for cvd_mode,
# min_contrast, focus_dim, and bell guidance.
osc52_read = off
cvd_mode = off
cvd_strength = 1.0

# Development smoke helper. Leave unset for normal interactive use.
# Startup-only; changing it in a live config file has no effect.
# native_autoclose_ms = 600
