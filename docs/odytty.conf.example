# Example OdyTTY config.
#
# Save as $XDG_CONFIG_HOME/odytty/odytty.conf or
# ~/.config/odytty/odytty.conf.
#
# Most values reload live while the native window is running. Environment
# variables set at startup override these keys for the whole session.

# Theme and OS appearance.
theme = odyssey
# theme = system
follow_os_theme = off
# os_theme_dark = odyssey
# os_theme_light = odyssey-light
themed_ui_roles = on

# Font and text.
font_family = JetBrains Mono
# font =
# font_weight =
font_size = 22
line_height = 1.0
text_gamma = 1.5
stem_darken = 0.5
subpixel = off
synthetic_styles = on
symbol_fallback = off
# symbol_font = auto
# symbol_map = U+E000-U+F8FF=Symbols Nerd Font

# Readability and rendering.
render_quality = balanced
min_contrast = 16.0
focus_dim = 0.0
# Dim the non-focused panes of a multi-pane tab (0.0 = off, byte-identical).
inactive_pane_dim = 0.0
geometric_boxdraw = off
box_thickness = 1.0
window_padding = 4
window_border = off
window_decorations = on

# Background treatments.
background_treatment = off
# background_treatment = gradient
# background_treatment = vignette
# background_treatment = image
# PNG, JPEG, and WebP wallpapers are supported.
# background_image = /path/to/background.jpg
cell_bg_opacity = 1.0
background_blur_radius = 0
# background_image_scrim = auto

# Post-process effects. "ambient" is a compatibility alias for the CRT path
# when no explicit "crt" setting is present. "crt" always wins.
visual = ambient
bloom = on
bloom_threshold = 0.75
bloom_intensity = 0.8
bloom_radius = 8.0
retro = off
crt = on
crt_scanline_intensity = 0.17
crt_scanline_period = 7.0
crt_vignette_strength = 0.10
crt_curvature = 0.0

# Cursor and motion.
cursor_style = block
cursor_blink = auto
cursor_easing = off
cursor_motion = off
cursor_glow = off
cursor_trail = off
new_output_fade = off

# Input, selection, and tabs. Tab rename is available from the tab context menu.
scroll_wheel_lines = 3
# Lines of scrollback history retained before the oldest are dropped (0 =
# unlimited; bounds memory so endless output cannot exhaust RAM).
scrollback_lines = 10000
scroll_drag_speed = ramp
smooth_scroll = off
selection_drag_extend = on
scrollbar_drag = on
wheel_zoom = on
copy_on_select = off
confirm_close = on
command_status_gutter = off
sh_click = off
keybinds =
# Example:
# keybinds = ctrl+shift+y=copy;ctrl+alt+v=paste
# Command palette opt-in example (unbound by default):
# keybinds = ctrl+alt+p=command-palette

# Connection hosts for the SSH manager live in:
#   $XDG_CONFIG_HOME/odytty/hosts.conf
#   ~/.config/odytty/hosts.conf when XDG_CONFIG_HOME is unset
# Format:
#   Host web1
#       HostName web1.example.invalid
#       User deploy
#       Port 2222
#       Theme odyssey
#       Font "Victor Mono"
#       Title "Synthetic Web"
#
# The connect action opens system ssh in a new tab/session as:
#   ssh [-p PORT] -- [USER@]HOST
# OdyTTY never reads, stores, prompts for, or passes credentials, private keys,
# or passphrases; authentication remains with the system ssh binary and agent.
#
# OpenSSH config import is default-off. While off, OdyTTY does not read
# ~/.ssh/config. When on, the import is read-only, name-only, bounded, and never
# surfaces key directives or credentials.
#
# Browse and quick-connect to saved hosts through the connection-manager overlay.
# Bind a chord to the connection-manager action to open it (no default chord, so
# the unset input path stays byte-identical), e.g.
# keybinds = ctrl+alt+h=connection-manager. The overlay is type-to-filter; Enter
# quick-connects, Esc dismisses. With ssh_config_hosts off it lists OdyTTY-owned
# hosts only and never references ~/.ssh.
ssh_config_hosts = off

# Per-session output recording for the scrubbable replay overlay. Default off:
# while off the PTY pump records nothing and the path is byte-identical. When on,
# each session keeps a bounded in-memory ring of recent screen frames (capped by
# 600 frames AND 24 MiB, whichever binds first). Recording is local-only — frames
# never touch disk or the network and are dropped when the session closes. Bind a
# chord to the session-replay action to open the scrubbable overlay, e.g.
# keybinds = ctrl+alt+r=session-replay.
session_replay = off

# Multiplexer prefix for pane/split management (tmux-style). Press the prefix,
# then a pane key: % / " split, arrows / o focus, x close, z zoom, space / =
# equalize. Press the prefix twice to send a literal prefix to the focused pane
# (so a tmux running inside OdyTTY still works). Set to off to disable and free
# the chord. Individual pane actions are rebindable via keybinds (the chord is
# the second key, after the prefix), e.g. keybinds = ctrl+f=zoom-pane.
pane_prefix = ctrl+b
# Example:
# pane_prefix = ctrl+a
# pane_prefix = off

# Detached-session CLI commands (`odytty new --detached`, `odytty list`,
# `odytty attach [--diagnostic] ID`) do not have config-file keys yet. By
# default, `attach <id>` reattaches a detached session in a live native window.
# `attach --diagnostic <id>` is the headless script/CI variant: it prints a
# one-line status dump and exits without opening a window. The host keeps the PTY
# and bounded terminal model alive until the child exits or the detached idle
# timeout reaps it.

# The command palette is configured through keybinds above. When opened it reads
# conventional shell history files read-only with fixed caps: 1 MiB tail,
# 20,000 physical lines, 5,000 entries, 4,096 chars per entry. Accepting a
# history/directory row types it into the active pane without pressing Enter.

# Clipboard and accessibility.
osc52_read = off
cvd_mode = off
cvd_strength = 1.0

# Development smoke helper. Leave unset for normal interactive use.
# Startup-only; changing it in a live config file has no effect.
# native_autoclose_ms = 600
