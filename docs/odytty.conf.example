# Example OdyTTY config.
# Copy values into $XDG_CONFIG_HOME/odytty/odytty.conf or
# ~/.config/odytty/odytty.conf.
# Most values below reload live while the native window is running, unless the
# matching ODYTTY_* environment variable was set at startup.

font_size = 18
font_family = JetBrains Mono
# font_weight =
window_padding = 4
theme = odyssey
# Back-compat alias: "ambient" and "scanlines" enable the CRT scanline effect
# when no explicit "crt" setting is present; "crt = on/off" always wins.
# Requires a GPU with filterable 16-bit float support; silently no-ops otherwise.
visual = ambient
subpixel = off
text_gamma = 1.5
stem_darken = 0.5
min_contrast = 13.0
focus_dim = 0.0
bloom = on
bloom_threshold = 0.75
bloom_intensity = 0.8
bloom_radius = 8.0
retro = off
crt = on
crt_scanline_intensity = 0.17
crt_scanline_period = 7.0
crt_vignette_strength = 0.10
cursor_style = block
cursor_blink = auto
# cursor_trail = off
# new_output_fade = off
# window_border = off
# window_decorations = on
# follow_os_theme = off
# os_theme_dark = odyssey
# os_theme_light = odyssey-light
confirm_close = on
# smooth_scroll = off
# smooth_scroll_duration = 80
keybinds = ctrl+shift+y=copy;ctrl+shift+p=paste

# Development smoke helper. Leave unset for normal interactive use.
# Startup-only; changing it in a live config file has no effect.
# native_autoclose_ms = 600
